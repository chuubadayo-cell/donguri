+//
+//  MediaThumbnailView.swift
+//  Donguri
+//
+//  Square thumbnail for an image or video, used under posts, in the
+//  gallery's thumbnail strip and in its grid. Decoded thumbnails are shared
+//  through MediaStore's memory cache, so a row scrolling back into view, or
+//  a thumbnail that was preloaded, draws immediately.
+//
+
+import SwiftUI
+import UIKit
+
+struct MediaThumbnailView: View {
+    let item: MediaItem
+    /// Fixed side length, or nil to fill the width offered (grid cells).
+    var side: CGFloat? = 84
+    var cornerRadius: CGFloat = 8
+    /// Decode size. Thumbnails share one size so a preloaded thumbnail is
+    /// reused wherever the item appears.
+    var pixelSize: CGFloat = MediaThumbnailView.rowPixelSize
+
+    /// 84pt at 3x. Preloading decodes at this size too.
+    static let rowPixelSize: CGFloat = 252
+    static let gridPixelSize: CGFloat = 360
+
+    @State private var image: UIImage?
+    @State private var failed = false
+
+    init(item: MediaItem, side: CGFloat? = 84, cornerRadius: CGFloat = 8,
+         pixelSize: CGFloat = MediaThumbnailView.rowPixelSize) {
+        self.item = item
+        self.side = side
+        self.cornerRadius = cornerRadius
+        self.pixelSize = pixelSize
+        _image = State(initialValue: MediaStore.shared.memoryImage(for: item.url, maxPixelSize: pixelSize))
+    }
+
+    var body: some View {
+        Rectangle()
+            .fill(Color.secondary.opacity(0.12))
+            .aspectRatio(1, contentMode: .fit)
+            .frame(width: side, height: side)
+            .overlay {
+                if let image {
+                    Image(uiImage: image)
+                        .resizable()
+                        .scaledToFill()
+                } else if item.kind == .unsupportedVideo {
+                    Image(systemName: "film")
+                        .foregroundStyle(.secondary)
+                } else if failed {
+                    Image(systemName: "photo.badge.exclamationmark")
+                        .foregroundStyle(.secondary)
+                } else {
+                    ProgressView()
+                        .controlSize(.small)
+                }
+            }
+            .overlay {
+                if item.isVideo {
+                    Image(systemName: "play.circle.fill")
+                        .font(.title2)
+                        .symbolRenderingMode(.palette)
+                        .foregroundStyle(.white, .black.opacity(0.45))
+                }
+            }
+            .overlay(alignment: .bottomLeading) {
+                if let badge {
+                    Text(verbatim: badge)
+                        .font(.system(size: 9, weight: .bold))
+                        .foregroundStyle(.white)
+                        .padding(.horizontal, 4)
+                        .padding(.vertical, 1)
+                        .background(Capsule().fill(.black.opacity(0.55)))
+                        .padding(4)
+                }
+            }
+            .clipShape(RoundedRectangle(cornerRadius: cornerRadius, style: .continuous))
+            .contentShape(Rectangle())
+            .task(id: item.id) {
+                guard image == nil else { return }
+                failed = false
+                let loaded = await MediaStore.shared.thumbnail(for: item, maxPixelSize: pixelSize)
+                image = loaded
+                failed = loaded == nil
+            }
+    }
+
+    private var badge: String? {
+        if item.kind == .unsupportedVideo { return "WebM" }
+        if item.isGIF { return "GIF" }
+        return nil
+    }
+}
diff --git a/Donguri/View/Gallery/ZoomableImageView.swift b/Donguri/View/Gallery/ZoomableImageView.swift
new file mode 100644
index 0000000..cf246fe
--- /dev/null
+++ b/Donguri/View/Gallery/ZoomableImageView.swift
@@ -0,0 +1,216 @@
+//
+//  ZoomableImageView.swift
+//  Donguri
+//
+//  One gallery page's image: pinch and double-tap zoom, panning while
+//  zoomed, single tap to show or hide the gallery's controls, and a vertical
+//  swipe to close. Built on UIScrollView, which gets zooming physics right in
+//  a way SwiftUI gestures don't, and plays animated GIFs through UIImageView.
+//
+
+import SwiftUI
+import UIKit
+
+struct ZoomableImageView: UIViewRepresentable {
+    let image: UIImage
+    var onTap: () -> Void = {}
+    var onZoomChange: (Bool) -> Void = { _ in }
+    /// 0 at rest, 1 once the swipe is far enough to close; drives the
+    /// background fade.
+    var onDismissProgress: (CGFloat) -> Void = { _ in }
+    var onDismiss: () -> Void = {}
+
+    func makeCoordinator() -> Coordinator {
+        Coordinator()
+    }
+
+    func makeUIView(context: Context) -> ZoomingScrollView {
+        let view = ZoomingScrollView()
+        view.callbacks = context.coordinator
+        context.coordinator.parent = self
+        view.display(image)
+        return view
+    }
+
+    func updateUIView(_ view: ZoomingScrollView, context: Context) {
+        context.coordinator.parent = self
+        if view.displayedImage !== image {
+            view.display(image)
+        }
+    }
+
+    final class Coordinator {
+        var parent: ZoomableImageView?
+
+        func tapped() { parent?.onTap() }
+        func zoomChanged(_ zoomed: Bool) { parent?.onZoomChange(zoomed) }
+        func dismissProgress(_ progress: CGFloat) { parent?.onDismissProgress(progress) }
+        func dismissed() { parent?.onDismiss() }
+    }
+}
+
+final class ZoomingScrollView: UIScrollView, UIScrollViewDelegate {
+    weak var callbacks: ZoomableImageView.Coordinator?
+
+    private let imageView = UIImageView()
+    private(set) var displayedImage: UIImage?
+    private var lastLaidOutSize: CGSize = .zero
+    private var wasZoomed = false
+
+    private lazy var dismissPan = UIPanGestureRecognizer(target: self, action: #selector(handleDismissPan(_:)))
+
+    /// How far (in points) the image has to travel to close the gallery.
+    private static let dismissDistance: CGFloat = 140
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        delegate = self
+        minimumZoomScale = 1
+        maximumZoomScale = 5
+        showsVerticalScrollIndicator = false
+        showsHorizontalScrollIndicator = false
+        contentInsetAdjustmentBehavior = .never
+        decelerationRate = .fast
+        backgroundColor = .clear
+        bouncesZoom = true
+
+        imageView.contentMode = .scaleAspectFit
+        imageView.clipsToBounds = true
+        imageView.isUserInteractionEnabled = true
+        addSubview(imageView)
+
+        let doubleTap = UITapGestureRecognizer(target: self, action: #selector(handleDoubleTap(_:)))
+        doubleTap.numberOfTapsRequired = 2
+        addGestureRecognizer(doubleTap)
+
+        let singleTap = UITapGestureRecognizer(target: self, action: #selector(handleSingleTap))
+        singleTap.require(toFail: doubleTap)
+        addGestureRecognizer(singleTap)
+
+        // No delegate on purpose: UIScrollView privately implements the
+        // gesture delegate methods for its own pinch and pan, and defining
+        // them here would silently override those.
+        addGestureRecognizer(dismissPan)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func display(_ image: UIImage) {
+        displayedImage = image
+        imageView.image = image
+        // Animated GIFs come back from MediaStore as UIImage.animatedImage,
+        // which UIImageView plays on its own.
+        if image.images != nil { imageView.startAnimating() }
+        zoomScale = 1
+        lastLaidOutSize = .zero
+        setNeedsLayout()
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        if bounds.size != lastLaidOutSize, bounds.width > 0, bounds.height > 0 {
+            lastLaidOutSize = bounds.size
+            zoomScale = 1
+            imageView.frame = CGRect(origin: .zero, size: fittedSize())
+            contentSize = imageView.frame.size
+        }
+        centerImage()
+    }
+
+    private func fittedSize() -> CGSize {
+        guard let image = displayedImage, image.size.width > 0, image.size.height > 0 else { return bounds.size }
+        let scale = min(bounds.width / image.size.width, bounds.height / image.size.height)
+        return CGSize(width: image.size.width * scale, height: image.size.height * scale)
+    }
+
+    /// Keeps a smaller-than-screen image in the middle rather than the corner.
+    private func centerImage() {
+        let offsetX = max((bounds.width - contentSize.width) / 2, 0)
+        let offsetY = max((bounds.height - contentSize.height) / 2, 0)
+        imageView.center = CGPoint(x: contentSize.width / 2 + offsetX,
+                                   y: contentSize.height / 2 + offsetY)
+    }
+
+    // MARK: UIScrollViewDelegate
+
+    func viewForZooming(in scrollView: UIScrollView) -> UIView? {
+        imageView
+    }
+
+    func scrollViewDidZoom(_ scrollView: UIScrollView) {
+        centerImage()
+        let zoomed = zoomScale > minimumZoomScale + 0.01
+        if zoomed != wasZoomed {
+            wasZoomed = zoomed
+            callbacks?.zoomChanged(zoomed)
+        }
+    }
+
+    // MARK: Taps
+
+    @objc private func handleSingleTap() {
+        callbacks?.tapped()
+    }
+
+    @objc private func handleDoubleTap(_ recognizer: UITapGestureRecognizer) {
+        if zoomScale > minimumZoomScale + 0.01 {
+            setZoomScale(minimumZoomScale, animated: true)
+        } else {
+            let point = recognizer.location(in: imageView)
+            let scale: CGFloat = 2.5
+            let size = CGSize(width: bounds.width / scale, height: bounds.height / scale)
+            zoom(to: CGRect(x: point.x - size.width / 2, y: point.y - size.height / 2,
+                            width: size.width, height: size.height),
+                 animated: true)
+        }
+    }
+
+    // MARK: Swipe to close
+
+    override func gestureRecognizerShouldBegin(_ gestureRecognizer: UIGestureRecognizer) -> Bool {
+        guard gestureRecognizer === dismissPan else {
+            return super.gestureRecognizerShouldBegin(gestureRecognizer)
+        }
+        // Only an unzoomed, mostly vertical swipe; horizontal ones page.
+        guard zoomScale <= minimumZoomScale + 0.01 else { return false }
+        let velocity = dismissPan.velocity(in: self)
+        return abs(velocity.y) > abs(velocity.x) * 1.3
+    }
+
+    @objc private func handleDismissPan(_ recognizer: UIPanGestureRecognizer) {
+        let translation = recognizer.translation(in: self)
+        let progress = min(abs(translation.y) / Self.dismissDistance, 1)
+
+        switch recognizer.state {
+        case .changed:
+            let shrink = 1 - progress * 0.15
+            imageView.transform = CGAffineTransform(translationX: translation.x, y: translation.y)
+                .scaledBy(x: shrink, y: shrink)
+            callbacks?.dismissProgress(progress)
+        case .ended, .cancelled:
+            let velocity = recognizer.velocity(in: self).y
+            let shouldClose = recognizer.state == .ended
+                && (abs(translation.y) > Self.dismissDistance || abs(velocity) > 900)
+            if shouldClose {
+                let direction: CGFloat = translation.y >= 0 ? 1 : -1
+                UIView.animate(withDuration: 0.2, delay: 0, options: .curveEaseOut) {
+                    self.imageView.transform = CGAffineTransform(translationX: translation.x,
+                                                                 y: direction * self.bounds.height)
+                    self.imageView.alpha = 0
+                }
+                callbacks?.dismissProgress(1)
+                callbacks?.dismissed()
+            } else {
+                UIView.animate(withDuration: 0.3, delay: 0,
+                               usingSpringWithDamping: 0.85, initialSpringVelocity: 0) {
+                    self.imageView.transform = .identity
+                }
+                callbacks?.dismissProgress(0)
+            }
+        default:
+            break
+        }
+    }
+}
diff --git a/Donguri/View/LibraryViews.swift b/Donguri/View/LibraryViews.swift
