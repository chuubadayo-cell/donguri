diff --git a/Donguri/Service/DatCache.swift b/Donguri/Service/DatCache.swift
new file mode 100644
index 0000000..12389cd
--- /dev/null
+++ b/Donguri/Service/DatCache.swift
@@ -0,0 +1,134 @@
+//
+//  DatCache.swift
+//  Donguri
+//
+//  Keeps each thread's raw .dat on disk so that reopening or refreshing a
+//  thread only downloads what was added since last time (差分取得), the way
+//  dedicated 5ch browsers do. A 1000-post thread is a few hundred kilobytes;
+//  a refresh with three new replies is now a few hundred bytes.
+//
+//  How it works: the request asks for the cached file's size minus one byte
+//  onward (`Range: bytes=N-1-`). If the server sends back exactly the byte we
+//  already had last (always a newline) followed by new data, the two are
+//  joined. Anything else, e.g. the file shrank because a post was deleted
+//  (あぼーん), falls back to downloading the whole file again.
+//
+//  Lives in Caches, so iOS may clear it when space is low; that only costs a
+//  full download next time.
+//
+
+import Foundation
+import CryptoKit
+
+actor DatCache {
+    nonisolated static let shared = DatCache()
+
+    nonisolated enum FetchError: Error {
+        case notFound
+    }
+
+    private nonisolated struct Meta: Codable {
+        var lastModified: String?
+    }
+
+    private let folder: URL? = {
+        guard let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        let folder = caches.appendingPathComponent("DatCache", isDirectory: true)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        return folder
+    }()
+
+    /// The whole .dat, downloading only the new part when possible.
+    func fetch(_ url: URL) async throws -> Data {
+        let cached = load(url)
+
+        var request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30)
+        if let cached, cached.data.count > 1, cached.data.last == 0x0A {
+            request.setValue("bytes=\(cached.data.count - 1)-", forHTTPHeaderField: "Range")
+            // A compressed response would make byte offsets meaningless.
+            request.setValue("identity", forHTTPHeaderField: "Accept-Encoding")
+            if let lastModified = cached.lastModified {
+                request.setValue(lastModified, forHTTPHeaderField: "If-Modified-Since")
+            }
+        }
+
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse else {
+            throw URLError(.badServerResponse)
+        }
+        let lastModified = http.value(forHTTPHeaderField: "Last-Modified")
+
+        switch http.statusCode {
+        case 200:
+            store(data, lastModified: lastModified, for: url)
+            return data
+        case 206:
+            guard let cached, data.first == 0x0A else {
+                return try await fetchWhole(url)
+            }
+            var merged = cached.data
+            merged.append(data.dropFirst())
+            store(merged, lastModified: lastModified ?? cached.lastModified, for: url)
+            return merged
+        case 304:
+            if let cached { return cached.data }
+            return try await fetchWhole(url)
+        case 416:
+            // The file is shorter than our copy: something was deleted.
+            return try await fetchWhole(url)
+        case 404:
+            throw FetchError.notFound
+        default:
+            throw URLError(.badServerResponse)
+        }
+    }
+
+    /// Whatever is on disk for this thread, without touching the network.
+    func cachedData(for url: URL) -> Data? {
+        load(url)?.data
+    }
+
+    func clear() {
+        guard let folder else { return }
+        try? FileManager.default.removeItem(at: folder)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+    }
+
+    private func fetchWhole(_ url: URL) async throws -> Data {
+        let request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30)
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse else {
+            throw URLError(.badServerResponse)
+        }
+        guard http.statusCode != 404 else { throw FetchError.notFound }
+        guard http.statusCode == 200 else { throw URLError(.badServerResponse) }
+        store(data, lastModified: http.value(forHTTPHeaderField: "Last-Modified"), for: url)
+        return data
+    }
+
+    private func paths(for url: URL) -> (dat: URL, meta: URL)? {
+        guard let folder else { return nil }
+        let digest = SHA256.hash(data: Data(url.absoluteString.utf8))
+        let name = digest.map { String(format: "%02x", $0) }.joined()
+        return (folder.appendingPathComponent(name + ".dat"),
+                folder.appendingPathComponent(name + ".json"))
+    }
+
+    private func load(_ url: URL) -> (data: Data, lastModified: String?)? {
+        guard let paths = paths(for: url),
+              let data = try? Data(contentsOf: paths.dat),
+              !data.isEmpty else { return nil }
+        let meta = (try? Data(contentsOf: paths.meta)).flatMap { try? JSONDecoder().decode(Meta.self, from: $0) }
+        return (data, meta?.lastModified)
+    }
+
+    private func store(_ data: Data, lastModified: String?, for url: URL) {
+        guard let paths = paths(for: url), !data.isEmpty else { return }
+        try? data.write(to: paths.dat, options: .atomic)
+        if let meta = try? JSONEncoder().encode(Meta(lastModified: lastModified)) {
+            try? meta.write(to: paths.meta, options: .atomic)
+        }
+    }
+}
diff --git a/Donguri/Service/FavoritesStore.swift b/Donguri/Service/FavoritesStore.swift
new file mode 100644
index 0000000..5c134bc
--- /dev/null
+++ b/Donguri/Service/FavoritesStore.swift
@@ -0,0 +1,187 @@
+//
+//  FavoritesStore.swift
+//  Donguri
+//
+//  Favorite boards and threads (お気に入り), shown at the top of the board
+//  menu. Backed by `UserDefaults`, like `ReadStateStore` and `NGFilterStore`.
+//
+
+import Foundation
+import SwiftUI
+
+@Observable
+final class FavoritesStore {
+    static let shared = FavoritesStore()
+
+    private static let boardsKey = "donguri.favoriteBoards"
+    private static let threadsKey = "donguri.favoriteThreads"
+
+    private(set) var boards: [FavoriteBoard]
+    private(set) var threads: [FavoriteThread]
+
+    /// Bumped whenever a read position changes. `ReadStateStore` isn't
+    /// observable, so views that show unread counts read this to know when to
+    /// redraw after the user comes back from a thread.
+    private(set) var readRevision = 0
+
+    /// True while `refreshThreadCounts` is fetching board listings.
+    private(set) var isRefreshing = false
+
+    private init() {
+        let defaults = UserDefaults.standard
+        if let data = defaults.data(forKey: Self.boardsKey),
+           let decoded = try? JSONDecoder().decode([FavoriteBoard].self, from: data) {
+            boards = decoded
+        } else {
+            boards = []
+        }
+        if let data = defaults.data(forKey: Self.threadsKey),
+           let decoded = try? JSONDecoder().decode([FavoriteThread].self, from: data) {
+            threads = decoded
+        } else {
+            threads = []
+        }
+    }
+
+    // MARK: Boards
+
+    func isFavorite(boardURL: String) -> Bool {
+        boards.contains { $0.url == boardURL }
+    }
+
+    func toggle(board: BBSMenu.CategoryContent) {
+        if isFavorite(boardURL: board.url) {
+            boards.removeAll { $0.url == board.url }
+        } else {
+            boards.append(FavoriteBoard(board))
+        }
+        persistBoards()
+    }
+
+    func removeBoards(atOffsets offsets: IndexSet) {
+        boards.remove(atOffsets: offsets)
+        persistBoards()
+    }
+
+    func moveBoards(fromOffsets source: IndexSet, toOffset destination: Int) {
+        boards.move(fromOffsets: source, toOffset: destination)
+        persistBoards()
+    }
+
+    // MARK: Threads
+
+    func isFavorite(boardURL: String, threadId: Int) -> Bool {
+        threads.contains { $0.boardURL == boardURL && $0.threadId == threadId }
+    }
+
+    func toggle(boardURL: String, boardName: String, threadId: Int, title: String, responseCount: Int) {
+        if isFavorite(boardURL: boardURL, threadId: threadId) {
+            threads.removeAll { $0.boardURL == boardURL && $0.threadId == threadId }
+        } else {
+            threads.insert(FavoriteThread(boardURL: boardURL,
+                                          boardName: boardName,
+                                          threadId: threadId,
+                                          title: title,
+                                          responseCount: max(responseCount, 0)),
+                           at: 0)
+        }
+        persistThreads()
+    }
+
+    func removeThreads(atOffsets offsets: IndexSet) {
+        threads.remove(atOffsets: offsets)
+        persistThreads()
+    }
+
+    func moveThreads(fromOffsets source: IndexSet, toOffset destination: Int) {
+        threads.move(fromOffsets: source, toOffset: destination)
+        persistThreads()
+    }
+
+    /// Called when a favorite thread has been opened, so its count and title
+    /// are current without waiting for the next board refresh.
+    func noteOpened(boardURL: String, threadId: Int, title: String?, responseCount: Int) {
+        guard let i = threads.firstIndex(where: { $0.boardURL == boardURL && $0.threadId == threadId }) else { return }
+        var changed = false
+        if responseCount > threads[i].responseCount {
+            threads[i].responseCount = responseCount
+            changed = true
+        }
+        if let title, !title.isEmpty, title != threads[i].title {
+            threads[i].title = title
+            changed = true
+        }
+        if changed { persistThreads() }
+    }
+
+    /// Updates favorite threads on one board from a freshly fetched listing.
+    /// Lets `BoardView` keep favorites current for free whenever it loads.
+    func update(boardURL: String, from listing: [Thread]) {
+        guard threads.contains(where: { $0.boardURL == boardURL }) else { return }
+        let counts = Dictionary(listing.map { ($0.id, $0.responseCount) },
+                                uniquingKeysWith: { first, _ in first })
+        var changed = false
+        for i in threads.indices where threads[i].boardURL == boardURL {
+            if let count = counts[threads[i].threadId] {
+                if count != threads[i].responseCount || threads[i].isArchived {
+                    threads[i].responseCount = count
+                    threads[i].isArchived = false
+                    changed = true
+                }
+            } else if !threads[i].isArchived {
+                threads[i].isArchived = true
+                changed = true
+            }
+        }
+        if changed { persistThreads() }
+    }
+
+    /// Fetches the listing of every board that has a favorite thread, so the
+    /// menu can show how many new replies each one has. One request per board.
+    func refreshThreadCounts() async {
+        guard !isRefreshing else { return }
+        let boardURLs = Array(Set(threads.filter { !$0.isArchived }.map(\.boardURL)))
+        guard !boardURLs.isEmpty else { return }
+
+        isRefreshing = true
+        defer { isRefreshing = false }
+
+        let service = ThreadService()
+        for boardURL in boardURLs {
+            do {
+                let listing = try await service.fetchThreads(boardURL: boardURL)
+                update(boardURL: boardURL, from: listing)
+            } catch {
+                // Offline, or the board moved servers. Keep the old counts.
+                print("FavoritesStore refresh error for \(boardURL): \(error)")
+            }
+        }
+    }
+
+    // MARK: Unread counts
+
+    func readStateDidChange() {
+        readRevision += 1
+    }
+
+    /// New replies since the user last read this thread, or nil if none or if
+    /// it has never been opened.
+    func unreadCount(for thread: FavoriteThread) -> Int? {
+        _ = readRevision
+        guard let state = ReadStateStore.shared.state(for: thread.id) else { return nil }
+        let unread = thread.responseCount - state.lastReadCount
+        return unread > 0 ? unread : nil
+    }
+
+    // MARK: Persistence
+
+    private func persistBoards() {
+        guard let data = try? JSONEncoder().encode(boards) else { return }
+        UserDefaults.standard.set(data, forKey: Self.boardsKey)
+    }
+
+    private func persistThreads() {
+        guard let data = try? JSONEncoder().encode(threads) else { return }
+        UserDefaults.standard.set(data, forKey: Self.threadsKey)
+    }
+}
diff --git a/Donguri/Service/HistoryStore.swift b/Donguri/Service/HistoryStore.swift
new file mode 100644
index 0000000..59c85fd
--- /dev/null
+++ b/Donguri/Service/HistoryStore.swift
@@ -0,0 +1,85 @@
+//
+//  HistoryStore.swift
+//  Donguri
+//
+//  Browsing history (閲覧履歴): every thread the user opens, newest first.
+//  Backed by `UserDefaults` and capped so it can't grow forever.
+//
+
+import Foundation
+import SwiftUI
+
+@Observable
+final class HistoryStore {
+    static let shared = HistoryStore()
+
+    private static let defaultsKey = "donguri.history"
+    private static let maxEntries = 300
+
+    private(set) var entries: [HistoryEntry]
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: Self.defaultsKey),
+           let decoded = try? JSONDecoder().decode([HistoryEntry].self, from: data) {
+            entries = decoded
+        } else {
+            entries = []
+        }
+    }
+
+    /// Moves the thread to the top of the history, adding it if it's new.
+    func record(boardURL: String, boardName: String?, threadId: Int, title: String?, responseCount: Int) {
+        let existing = entries.first { $0.boardURL == boardURL && $0.threadId == threadId }
+        entries.removeAll { $0.boardURL == boardURL && $0.threadId == threadId }
+
+        let resolvedTitle = title.flatMap { $0.isEmpty ? nil : $0 }
+            ?? existing?.title
+            ?? String(localized: "無題")
+
+        entries.insert(HistoryEntry(boardURL: boardURL,
+                                    boardName: boardName ?? existing?.boardName ?? knownBoardName(for: boardURL),
+                                    threadId: threadId,
+                                    title: resolvedTitle,
+                                    responseCount: max(responseCount, existing?.responseCount ?? 0),
+                                    lastViewed: .now),
+                       at: 0)
+
+        if entries.count > Self.maxEntries {
+            entries.removeLast(entries.count - Self.maxEntries)
+        }
+        persist()
+    }
+
+    func remove(atOffsets offsets: IndexSet) {
+        entries.remove(atOffsets: offsets)
+        persist()
+    }
+
+    func remove(id: String) {
+        entries.removeAll { $0.id == id }
+        persist()
+    }
+
+    func clear() {
+        entries.removeAll()
+        persist()
+    }
+
+    /// The board's real name if any part of the library has seen it, so a
+    /// thread opened from a link still gets a readable board name.
+    func knownBoardName(for boardURL: String) -> String {
+        if let board = FavoritesStore.shared.boards.first(where: { $0.url == boardURL }) {
+            return board.boardName
+        }
+        let fallback = BoardNames.fallback(for: boardURL)
+        if let entry = entries.first(where: { $0.boardURL == boardURL && $0.boardName != fallback }) {
+            return entry.boardName
+        }
+        return fallback
+    }
+
+    private func persist() {
+        guard let data = try? JSONEncoder().encode(entries) else { return }
+        UserDefaults.standard.set(data, forKey: Self.defaultsKey)
+    }
+}
diff --git a/Donguri/Service/MediaDownloads.swift b/Donguri/Service/MediaDownloads.swift
new file mode 100644
index 0000000..6f41c4f
--- /dev/null
+++ b/Donguri/Service/MediaDownloads.swift
@@ -0,0 +1,274 @@
+//
+//  MediaDownloads.swift
+//  Donguri
+//
+//  Bulk media work with visible progress: "download all images" in a thread,
+//  keeping a saved thread's images for offline reading, and saving to Photos.
+//
+
+import Foundation
+import Network
+import Photos
+import SwiftUI
+import UIKit
+
+/// Whether the current connection is metered (cellular, Personal Hotspot, or
+/// Low Data Mode), for the "Wi-Fi only" preload setting.
+@Observable
+final class NetworkMonitor {
+    static let shared = NetworkMonitor()
+
+    private(set) var isExpensive = false
+    private(set) var isConnected = true
+
+    private let monitor = NWPathMonitor()
+
+    private init() {
+        monitor.pathUpdateHandler = { @Sendable path in
+            let expensive = path.isExpensive || path.isConstrained
+            let connected = path.status == .satisfied
+            Task { @MainActor in
+                NetworkMonitor.shared.update(expensive: expensive, connected: connected)
+            }
+        }
+        monitor.start(queue: DispatchQueue(label: "donguri.network-monitor"))
+    }
+
+    private func update(expensive: Bool, connected: Bool) {
+        if isExpensive != expensive { isExpensive = expensive }
+        if isConnected != connected { isConnected = connected }
+    }
+}
+
+/// Progress of one bulk job, shown as a banner in the thread or gallery.
+@Observable
+final class MediaJob {
+    nonisolated enum Action: Sendable {
+        /// Download into the cache.
+        case download
+        /// Download and keep for offline reading.
+        case pin
+        /// Download and add to the photo library.
+        case saveToPhotos
+    }
+
+    private(set) var total = 0
+    private(set) var completed = 0
+    private(set) var failed = 0
+    private(set) var isRunning = false
+    private(set) var action: Action = .download
+    /// Set when the job ended because Photos access was refused.
+    private(set) var photosDenied = false
+
+    private var task: Task<Void, Never>?
+
+    var progressText: String {
+        switch action {
+        case .download:
+            String(localized: "画像をダウンロード中 \(completed + failed)/\(total)")
+        case .pin:
+            String(localized: "オフライン用に画像を保存中 \(completed + failed)/\(total)")
+        case .saveToPhotos:
+            String(localized: "写真に保存中 \(completed + failed)/\(total)")
+        }
+    }
+
+    var summaryText: String {
+        if photosDenied {
+            return String(localized: "写真へのアクセスが許可されていません")
+        }
+        switch action {
+        case .download, .pin:
+            return failed == 0
+                ? String(localized: "\(completed)件の画像を保存しました")
+                : String(localized: "\(completed)件を保存・\(failed)件は読み込めませんでした")
+        case .saveToPhotos:
+            return failed == 0
+                ? String(localized: "\(completed)件を写真に保存しました")
+                : String(localized: "\(completed)件を写真に保存・\(failed)件は失敗しました")
+        }
+    }
+
+    /// Runs `action` over `items`, a few at a time.
+    func start(_ action: Action, items: [MediaItem], onFinish: ((MediaJob) -> Void)? = nil) {
+        cancel()
+        let items = action == .saveToPhotos ? items.filter { $0.kind != .unsupportedVideo } : items
+        guard !items.isEmpty else { return }
+
+        self.action = action
+        total = items.count
+        completed = 0
+        failed = 0
+        photosDenied = false
+        isRunning = true
+
+        task = Task { [weak self] in
+            if action == .saveToPhotos {
+                let status = await PHPhotoLibrary.requestAuthorization(for: .addOnly)
+                guard status == .authorized || status == .limited else {
+                    self?.photosDenied = true
+                    self?.finish(onFinish)
+                    return
+                }
+            }
+
+            await withTaskGroup(of: Bool.self) { group in
+                var next = 0
+                let width = action == .saveToPhotos ? 2 : 4
+
+                func addNext() {
+                    guard next < items.count else { return }
+                    let item = items[next]
+                    next += 1
+                    group.addTask {
+                        await MediaJob.perform(action, on: item)
+                    }
+                }
+
+                for _ in 0..<width { addNext() }
+
+                for await succeeded in group {
+                    guard let self, !Task.isCancelled else {
+                        group.cancelAll()
+                        break
+                    }
+                    if succeeded { self.completed += 1 } else { self.failed += 1 }
+                    addNext()
+                }
+            }
+
+            self?.finish(onFinish)
+        }
+    }
+
+    func cancel() {
+        task?.cancel()
+        task = nil
+        isRunning = false
+    }
+
+    private func finish(_ onFinish: ((MediaJob) -> Void)?) {
+        isRunning = false
+        task = nil
+        onFinish?(self)
+    }
+
+    private nonisolated static func perform(_ action: Action, on item: MediaItem) async -> Bool {
+        do {
+            switch action {
+            case .download:
+                _ = try await MediaStore.shared.file(for: item.url)
+            case .pin:
+                try await MediaStore.shared.pin(item.url)
+            case .saveToPhotos:
+                let file = try await MediaStore.shared.file(for: item.url)
+                try await PhotoSaver.save(file: file, isVideo: item.isVideo)
+            }
+            return true
+        } catch {
+            return false
+        }
+    }
+}
+
+nonisolated enum PhotoSaver {
+    /// Formats Photos takes as-is. Anything else (WebP, BMP) is re-encoded.
+    private static let directFormats: Set<String> = ["jpg", "jpeg", "png", "gif", "heic", "mp4", "mov", "m4v"]
+
+    static func save(file: URL, isVideo: Bool) async throws {
+        let ext = file.pathExtension.lowercased()
+        if directFormats.contains(ext) {
+            try await PHPhotoLibrary.shared().performChanges {
+                let request = PHAssetCreationRequest.forAsset()
+                request.addResource(with: isVideo ? .video : .photo, fileURL: file, options: nil)
+            }
+        } else {
+            guard !isVideo,
+                  let data = try? Data(contentsOf: file),
+                  let image = UIImage(data: data),
+                  let jpeg = image.jpegData(compressionQuality: 0.95) else {
+                throw CocoaError(.fileReadCorruptFile)
+            }
+            try await PHPhotoLibrary.shared().performChanges {
+                let request = PHAssetCreationRequest.forAsset()
+                request.addResource(with: .photo, data: jpeg, options: nil)
+            }
+        }
+    }
+}
+
+/// Preloads thumbnails a little ahead of the scroll position, and, when the
+/// setting asks for it, everything in the thread. Deliberately not
+/// observable: it only starts downloads, so nothing should redraw when it
+/// changes.
+final class NearbyPrefetcher {
+    /// How many posts below a newly visible row get their thumbnails loaded.
+    private static let lookahead = 25
+
+    private var requestedThrough = -1
+    private var allTask: Task<Void, Never>?
+
+    func reset() {
+        requestedThrough = -1
+        allTask?.cancel()
+        allTask = nil
+    }
+
+    func rowAppeared(_ index: Int, mediaByPost: [Int: [MediaItem]]) {
+        guard MediaPrefetchMode.current != .off else { return }
+        let end = index + Self.lookahead
+        guard end > requestedThrough else { return }
+        let start = max(index, requestedThrough + 1)
+        requestedThrough = end
+
+        let items = (start...end).flatMap { mediaByPost[$0] ?? [] }
+        guard !items.isEmpty else { return }
+        let size = MediaThumbnailView.rowPixelSize
+        Task.detached(priority: .utility) {
+            await NearbyPrefetcher.loadThumbnails(items, size: size)
+        }
+    }
+
+    func prefetchAll(_ items: [MediaItem]) {
+        allTask?.cancel()
+        let images = items.filter { $0.kind == .image }
+        guard !images.isEmpty else { return }
+        let size = MediaThumbnailView.rowPixelSize
+        allTask = Task.detached(priority: .utility) {
+            await NearbyPrefetcher.loadThumbnails(images, size: size)
+        }
+    }
+
+    /// Four at a time: quick, without starving what's on screen.
+    private nonisolated static func loadThumbnails(_ items: [MediaItem], size: CGFloat) async {
+        var index = 0
+        while index < items.count, !Task.isCancelled {
+            let batch = items[index..<min(index + 4, items.count)]
+            index += batch.count
+            await withTaskGroup(of: Void.self) { group in
+                for item in batch {
+                    group.addTask {
+                        _ = await MediaStore.shared.thumbnail(for: item, maxPixelSize: size)
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Which gallery to show, set by `ThreadView`.
+struct GalleryRequest: Identifiable {
+    let id = UUID()
+    let startIndex: Int
+    let showGrid: Bool
+}
+
+extension Transaction {
+    /// The gallery fades itself in and out; this keeps the system's
+    /// slide-up animation for full-screen covers out of the way.
+    static var noAnimation: Transaction {
+        var transaction = Transaction()
+        transaction.disablesAnimations = true
+        return transaction
+    }
+}
diff --git a/Donguri/Service/MediaStore.swift b/Donguri/Service/MediaStore.swift
new file mode 100644
index 0000000..4c07196
--- /dev/null
+++ b/Donguri/Service/MediaStore.swift
@@ -0,0 +1,344 @@
+//
+//  MediaStore.swift
+//  Donguri
+//
+//  Downloads, caches and decodes the images and videos linked from posts.
+//
+//  Three layers, checked in order:
+//   1. Memory: decoded images, sized for where they're shown (NSCache, so
+//      iOS can reclaim it under memory pressure).
+//   2. Pinned files (Application Support/SavedMedia): media belonging to
+//      threads saved for offline reading. Never trimmed automatically.
+//   3. Cached files (Caches/Media): everything else that has been viewed or
+//      preloaded, trimmed oldest-first past `cacheLimitBytes`.
+//
+//  Anything missing is downloaded once; concurrent requests for the same URL
+//  share one download.
+//
+
+import Foundation
+import UIKit
+import ImageIO
+import AVFoundation
+import CryptoKit
+
+actor MediaStore {
+    nonisolated static let shared = MediaStore()
+
+    /// The disk cache is trimmed back under this at launch.
+    nonisolated static let cacheLimitBytes: Int64 = 1_000_000_000
+
+    /// NSCache is thread-safe, which is what makes reading it from
+    /// `nonisolated` code (for an instant, flicker-free cache hit) sound.
+    private nonisolated(unsafe) let memory: NSCache<NSString, UIImage> = {
+        let cache = NSCache<NSString, UIImage>()
+        cache.totalCostLimit = 200 * 1024 * 1024
+        return cache
+    }()
+
+    private let cacheFolder: URL?
+    private let pinnedFolder: URL?
+
+    private var inFlight: [URL: Task<URL, Error>] = [:]
+
+    init() {
+        let fileManager = FileManager.default
+        cacheFolder = fileManager.urls(for: .cachesDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("Media", isDirectory: true)
+        pinnedFolder = fileManager.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("SavedMedia", isDirectory: true)
+        for folder in [cacheFolder, pinnedFolder].compactMap({ $0 }) {
+            try? fileManager.createDirectory(at: folder, withIntermediateDirectories: true)
+        }
+    }
+
+    // MARK: Files
+
+    /// The local copy of `url`, if it has already been downloaded.
+    nonisolated func existingFile(for url: URL) -> URL? {
+        let name = Self.fileName(for: url)
+        for folder in [pinnedFolder, cacheFolder].compactMap({ $0 }) {
+            let file = folder.appendingPathComponent(name)
+            if FileManager.default.fileExists(atPath: file.path(percentEncoded: false)) {
+                return file
+            }
+        }
+        return nil
+    }
+
+    /// A local copy of `url`, downloading it first if needed.
+    func file(for url: URL) async throws -> URL {
+        if let existing = existingFile(for: url) {
+            Self.touch(existing)
+            return existing
+        }
+        if let running = inFlight[url] {
+            return try await running.value
+        }
+        guard let cacheFolder else { throw URLError(.cannotCreateFile) }
+
+        let destination = cacheFolder.appendingPathComponent(Self.fileName(for: url))
+        let task = Task<URL, Error> {
+            try await Self.download(url, to: destination)
+            return destination
+        }
+        inFlight[url] = task
+        defer { inFlight[url] = nil }
+        return try await task.value
+    }
+
+    /// Downloads without decoding: used to preload, and by "download all".
+    func prefetch(_ url: URL) async -> Bool {
+        (try? await file(for: url)) != nil
+    }
+
+    /// Makes sure `url` is kept for offline reading.
+    func pin(_ url: URL) async throws {
+        guard let pinnedFolder else { throw URLError(.cannotCreateFile) }
+        let name = Self.fileName(for: url)
+        let pinned = pinnedFolder.appendingPathComponent(name)
+        if FileManager.default.fileExists(atPath: pinned.path(percentEncoded: false)) { return }
+
+        let source = try await file(for: url)
+        if source != pinned {
+            try? FileManager.default.removeItem(at: pinned)
+            try FileManager.default.moveItem(at: source, to: pinned)
+        }
+    }
+
+    /// Releases offline copies; they move back into the ordinary cache.
+    func unpin(_ urls: [URL]) {
+        guard let pinnedFolder, let cacheFolder else { return }
+        for url in urls {
+            let name = Self.fileName(for: url)
+            let pinned = pinnedFolder.appendingPathComponent(name)
+            guard FileManager.default.fileExists(atPath: pinned.path(percentEncoded: false)) else { continue }
+            let cached = cacheFolder.appendingPathComponent(name)
+            try? FileManager.default.removeItem(at: cached)
+            try? FileManager.default.moveItem(at: pinned, to: cached)
+        }
+    }
+
+    // MARK: Images
+
+    /// A decoded image. `maxPixelSize` downsamples (thumbnails); nil gives the
+    /// full-size image for the gallery, animated if it's an animated GIF.
+    func image(for url: URL, maxPixelSize: CGFloat?) async -> UIImage? {
+        let key = Self.memoryKey(url, maxPixelSize)
+        if let cached = memory.object(forKey: key) { return cached }
+        guard let file = try? await file(for: url) else { return nil }
+        guard let image = await Self.decode(file, maxPixelSize: maxPixelSize) else { return nil }
+        memory.setObject(image, forKey: key, cost: Self.cost(of: image))
+        return image
+    }
+
+    /// Instant memory-only lookup, so a row that scrolls back on screen can
+    /// draw its thumbnail in the same frame instead of flashing a spinner.
+    nonisolated func memoryImage(for url: URL, maxPixelSize: CGFloat?) -> UIImage? {
+        memory.object(forKey: Self.memoryKey(url, maxPixelSize))
+    }
+
+    /// A still frame for a video, for thumbnails and the gallery strip.
+    func videoThumbnail(for url: URL, maxPixelSize: CGFloat) async -> UIImage? {
+        let key = Self.memoryKey(url, maxPixelSize)
+        if let cached = memory.object(forKey: key) { return cached }
+        // A cached file is much faster than reading the start of a remote one.
+        let source = existingFile(for: url) ?? url
+        guard let image = await Self.videoFrame(source, maxPixelSize: maxPixelSize) else { return nil }
+        memory.setObject(image, forKey: key, cost: Self.cost(of: image))
+        return image
+    }
+
+    /// Thumbnail for either kind of item.
+    func thumbnail(for item: MediaItem, maxPixelSize: CGFloat) async -> UIImage? {
+        switch item.kind {
+        case .image:
+            return await image(for: item.url, maxPixelSize: maxPixelSize)
+        case .video:
+            return await videoThumbnail(for: item.url, maxPixelSize: maxPixelSize)
+        case .unsupportedVideo:
+            return nil
+        }
+    }
+
+    // MARK: Cache management
+
+    func cacheSizeBytes() -> (cached: Int64, pinned: Int64) {
+        (Self.folderSize(cacheFolder), Self.folderSize(pinnedFolder))
+    }
+
+    func clearCache() {
+        memory.removeAllObjects()
+        guard let cacheFolder else { return }
+        try? FileManager.default.removeItem(at: cacheFolder)
+        try? FileManager.default.createDirectory(at: cacheFolder, withIntermediateDirectories: true)
+    }
+
+    /// Deletes the least recently used cached files until the cache fits.
+    func trimCache(to limit: Int64 = MediaStore.cacheLimitBytes) {
+        guard let cacheFolder,
+              let files = try? FileManager.default.contentsOfDirectory(
+                at: cacheFolder,
+                includingPropertiesForKeys: [.contentModificationDateKey, .fileSizeKey]
+              ) else { return }
+
+        var entries: [(url: URL, date: Date, size: Int64)] = files.compactMap { file in
+            guard let values = try? file.resourceValues(forKeys: [.contentModificationDateKey, .fileSizeKey]) else {
+                return nil
+            }
+            return (url: file,
+                    date: values.contentModificationDate ?? .distantPast,
+                    size: Int64(values.fileSize ?? 0))
+        }
+        var total = entries.reduce(Int64(0)) { $0 + $1.size }
+        guard total > limit else { return }
+
+        entries.sort { $0.date < $1.date }
+        for entry in entries where total > limit {
+            try? FileManager.default.removeItem(at: entry.url)
+            total -= entry.size
+        }
+    }
+
+    // MARK: Helpers
+
+    /// `<sha256 of the URL>.<ext>`. The real extension matters: Photos and the
+    /// share sheet decide what a file is from it.
+    nonisolated static func fileName(for url: URL) -> String {
+        let digest = SHA256.hash(data: Data(url.absoluteString.utf8))
+        let hash = digest.map { String(format: "%02x", $0) }.joined()
+        return "\(hash).\(fileExtension(for: url))"
+    }
+
+    nonisolated static func fileExtension(for url: URL) -> String {
+        let known = ["jpg", "jpeg", "png", "gif", "webp", "bmp", "heic", "mp4", "mov", "m4v", "webm"]
+        let ext = url.pathExtension.lowercased()
+        if known.contains(ext) { return ext }
+        // pbs.twimg.com/media/…?format=jpg
+        if let format = URLComponents(url: url, resolvingAgainstBaseURL: false)?
+            .queryItems?.first(where: { $0.name == "format" })?.value?.lowercased(),
+           known.contains(format) {
+            return format
+        }
+        return "jpg"
+    }
+
+    private nonisolated static func memoryKey(_ url: URL, _ maxPixelSize: CGFloat?) -> NSString {
+        "\(Int(maxPixelSize ?? 0))|\(url.absoluteString)" as NSString
+    }
+
+    private nonisolated static func cost(of image: UIImage) -> Int {
+        let frames = max(image.images?.count ?? 1, 1)
+        let pixels = image.size.width * image.scale * image.size.height * image.scale
+        return Int(pixels) * 4 * frames
+    }
+
+    /// Bumps the file's date so `trimCache` treats it as recently used.
+    private nonisolated static func touch(_ file: URL) {
+        try? FileManager.default.setAttributes([.modificationDate: Date.now],
+                                               ofItemAtPath: file.path(percentEncoded: false))
+    }
+
+    private nonisolated static func folderSize(_ folder: URL?) -> Int64 {
+        guard let folder,
+              let files = try? FileManager.default.contentsOfDirectory(at: folder,
+                                                                       includingPropertiesForKeys: [.fileSizeKey]) else {
+            return 0
+        }
+        return files.reduce(Int64(0)) { total, file in
+            total + Int64((try? file.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0)
+        }
+    }
+
+    private nonisolated static func download(_ url: URL, to destination: URL) async throws {
+        let request = URLRequest(url: url, cachePolicy: .useProtocolCachePolicy, timeoutInterval: 60)
+        let (temporary, response) = try await URLSession.shared.download(for: request)
+        defer { try? FileManager.default.removeItem(at: temporary) }
+
+        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {
+            throw URLError(.badServerResponse)
+        }
+        // Dead image links often answer with an HTML page instead of a 404.
+        if let mime = http.mimeType?.lowercased(), mime.hasPrefix("text/") {
+            throw URLError(.cannotDecodeContentData)
+        }
+
+        try? FileManager.default.removeItem(at: destination)
+        try FileManager.default.moveItem(at: temporary, to: destination)
+    }
+
+    /// Decoding happens off the actor so several thumbnails can decode at once.
+    @concurrent
+    private nonisolated static func decode(_ file: URL, maxPixelSize: CGFloat?) async -> UIImage? {
+        let sourceOptions = [kCGImageSourceShouldCache: false] as CFDictionary
+        guard let source = CGImageSourceCreateWithURL(file as CFURL, sourceOptions) else { return nil }
+
+        let frameCount = CGImageSourceGetCount(source)
+        if maxPixelSize == nil, frameCount > 1 {
+            return animatedImage(from: source, frameCount: frameCount)
+        }
+        // "Full size" is still capped: big enough to zoom into on any iPhone,
+        // small enough that the pages either side fit in memory too. A
+        // 12,000px photo would otherwise take half a gigabyte decoded.
+        return frame(at: 0, of: source, maxPixelSize: maxPixelSize ?? 2560).map { UIImage(cgImage: $0) }
+    }
+
+    private nonisolated static func frame(at index: Int, of source: CGImageSource, maxPixelSize: CGFloat) -> CGImage? {
+        let options: [CFString: Any] = [
+            kCGImageSourceCreateThumbnailFromImageAlways: true,
+            kCGImageSourceCreateThumbnailWithTransform: true,
+            kCGImageSourceShouldCacheImmediately: true,
+            kCGImageSourceThumbnailMaxPixelSize: maxPixelSize,
+        ]
+        return CGImageSourceCreateThumbnailAtIndex(source, index, options as CFDictionary)
+    }
+
+    private nonisolated static func animatedImage(from source: CGImageSource, frameCount: Int) -> UIImage? {
+        // Long GIFs are thinned rather than decoded frame for frame.
+        let maxFrames = 240
+        let step = max(1, Int((Double(frameCount) / Double(maxFrames)).rounded(.up)))
+        var frames: [UIImage] = []
+        var duration: Double = 0
+
+        for index in stride(from: 0, to: frameCount, by: step) {
+            guard let cgImage = frame(at: index, of: source, maxPixelSize: 1600) else { continue }
+            frames.append(UIImage(cgImage: cgImage))
+            duration += frameDelay(at: index, of: source) * Double(step)
+        }
+        guard !frames.isEmpty else { return nil }
+        if frames.count == 1 { return frames[0] }
+        return UIImage.animatedImage(with: frames, duration: duration)
+    }
+
+    private nonisolated static func frameDelay(at index: Int, of source: CGImageSource) -> Double {
+        guard let properties = CGImageSourceCopyPropertiesAtIndex(source, index, nil) as? [CFString: Any] else {
+            return 0.1
+        }
+        let dictionaries = [kCGImagePropertyGIFDictionary, kCGImagePropertyPNGDictionary, kCGImagePropertyWebPDictionary]
+        for key in dictionaries {
+            guard let dictionary = properties[key] as? [CFString: Any] else { continue }
+            let unclamped = (dictionary[kCGImagePropertyGIFUnclampedDelayTime]
+                             ?? dictionary[kCGImagePropertyAPNGUnclampedDelayTime]
+                             ?? dictionary[kCGImagePropertyWebPUnclampedDelayTime]) as? Double
+            let clamped = (dictionary[kCGImagePropertyGIFDelayTime]
+                           ?? dictionary[kCGImagePropertyAPNGDelayTime]
+                           ?? dictionary[kCGImagePropertyWebPDelayTime]) as? Double
+            if let delay = unclamped ?? clamped {
+                // Browsers treat very short delays as 0.1s; so do we.
+                return delay < 0.02 ? 0.1 : delay
+            }
+        }
+        return 0.1
+    }
+
+    @concurrent
+    private nonisolated static func videoFrame(_ url: URL, maxPixelSize: CGFloat) async -> UIImage? {
+        let generator = AVAssetImageGenerator(asset: AVURLAsset(url: url))
+        generator.appliesPreferredTrackTransform = true
+        generator.maximumSize = CGSize(width: maxPixelSize, height: maxPixelSize)
+        guard let result = try? await generator.image(at: CMTime(seconds: 0.5, preferredTimescale: 600)) else {
+            return nil
+        }
+        return UIImage(cgImage: result.image)
+    }
+}
